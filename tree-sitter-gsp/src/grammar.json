      "content": {
        "type": "PATTERN",
        "value": "\\[([^\\[\\]{}\"']|\"([^\"\\\\\\n]|\\\\.)*\"|'([^'\\\\\\n]|\\\\.)*'|[\\[{]([^\\[\\]{}\"']|\"([^\"\\\\\\n]|\\\\.)*\"|'([^'\\\\\\n]|\\\\.)*'|[\\[{]([^\\[\\]{}\"']|\"([^\"\\\\\\n]|\\\\.)*\"|'([^'\\\\\\n]|\\\\.)*'|[\\[{]([^\\[\\]{}\"']|\"([^\"\\\\\\n]|\\\\.)*\"|'([^'\\\\\\n]|\\\\.)*')*[\\]}])*[\\]}])*[\\]}])*\\]"
